LXGA_DB_PATH=data/demo/liu_xi_growth_analytics.duckdb
LXGA_API_HOST=0.0.0.0
LXGA_API_PORT=8000
LXGA_DEMO_USERS=100000
LXGA_DEMO_SEED=42
LXGA_COPILOT_NARRATIVE_MODE=deterministic

# 可选：启用本地 Ollama 时，把上一行改为 ollama，并填写以下两项。
# 未安装、超时或输出越过证据边界时，系统自动回退到确定性证据模板。
# 直接运行 Python 后端使用 http://127.0.0.1:11434；
# Docker Compose 使用 http://host.docker.internal:11434。请按运行方式填写其一。
LXGA_OLLAMA_BASE_URL=
LXGA_OLLAMA_MODEL=qwen2.5:7b
